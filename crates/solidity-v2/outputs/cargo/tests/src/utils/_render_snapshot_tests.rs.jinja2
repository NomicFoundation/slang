
{%- component v2.snapshots.render_snapshot_tests(crate_name, path, runner) -%}
    use anyhow::Result;

    use {{ runner }}::run;

    {% set entries = collect_snapshot_tests(crate_name=crate_name, path=path) -%}
    {% for entry in entries %}
        {{<v2.snapshots.render_entry entry={entry} path="" />}}
    {% endfor %}
{%- endcomponent v2.snapshots.render_snapshot_tests -%}

{%- component v2.snapshots.render_entry(entry, path) -%}
    {%- if entry.type == "Test" -%}
        #[test]
        fn {{ entry.name }}() -> Result<()> {
            run("{{ path }}", "{{ entry.name }}")
        }

    {%- elif entry.type == "Group" -%}
        {%- if path == "" %}
            {% set sub_path = entry.name %}
        {% else %}
            {% set sub_path = path ~ "/" ~ entry.name %}
        {% endif -%}

        mod {{ entry.name | snake_case }} {
            use super::*;

            {% for child in entry.children %}
                {{<v2.snapshots.render_entry entry={child} path={sub_path} />}}
            {% endfor %}
        }

    {%- else -%}
        {{ throw(message = "Unrecognized entry type: " ~ entry.type) }}
    {%- endif -%}
{%- endcomponent v2.snapshots.render_entry -%}
