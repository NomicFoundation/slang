use std::convert::TryFrom;
use std::fmt::{Display, Formatter};

use semver::Version;
use serde::{Deserialize, Serialize};
use thiserror::Error;

/// All supported versions of `{{ model.language.name }}`.
#[derive(Clone, Copy, Debug, Deserialize, Eq, Ord, PartialEq, PartialOrd, Serialize)]
#[serde(into = "Version", try_from = "Version")]
pub enum LanguageVersion {
    {% for version in model.language.versions %}
        V{{ version | split(pat=".") | join(sep="_") }},
    {%- endfor -%}
}

impl LanguageVersion {
    /// The earliest supported version of `{{ model.language.name }}`.
    pub const EARLIEST: Self = Self::V{{ model.language.versions | first | split(pat=".") | join(sep="_") }};

    /// The latest supported version of `{{ model.language.name }}`.
    pub const LATEST: Self = Self::V{{ model.language.versions | last | split(pat=".") | join(sep="_") }};

    /// All supported versions of `{{ model.language.name }}`, in order.
    pub const ALL: &'static [LanguageVersion; {{ model.language.versions | length }}] = &[
        {%- for version in model.language.versions %}
            LanguageVersion::V{{ version | split(pat=".") | join(sep="_") }},
        {%- endfor %}
    ];
}

#[derive(Clone, Copy, Debug, Eq, PartialEq, Error, Hash)]
pub enum LanguageVersionConversionError {
    #[error("provided version is not supported")]
    UnsupportedVersion,
    #[error("versions with pre-release or build metadata are not supported")]
    UnexpectedMetadata,
}

impl TryFrom<Version> for LanguageVersion {
    type Error = LanguageVersionConversionError;

    #[allow(clippy::too_many_lines)]
    fn try_from(version: Version) -> Result<Self, Self::Error> {
        let Version {
            major,
            minor,
            patch,
            pre,
            build,
        } = &version;

        if !pre.is_empty() || !build.is_empty() {
            return Err(LanguageVersionConversionError::UnexpectedMetadata);
        }

        Ok(match (major, minor, patch) {
            {%- for version in model.language.versions %}
                ({{ version | split(pat=".") | join(sep=", ") }}) => {
                    {{<v2.versions.version v={version} />}}
                }
            {%- endfor %}
            _ => return Err(LanguageVersionConversionError::UnsupportedVersion),
        })
    }
}

impl From<LanguageVersion> for Version {
    fn from(version: LanguageVersion) -> Self {
        match version {
            {%- for version in model.language.versions %}
                {{<v2.versions.version v={version} />}} => Version::new({{ (version | split(pat="."))[0] }}, {{ (version | split(pat="."))[1] }}, {{ (version | split(pat="."))[2] }}),
            {%- endfor %}
        }
    }
}

impl Display for LanguageVersion {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        match self {
            {%- for version in model.language.versions %}
                {{<v2.versions.version v={version} />}} => write!(f, "{{ version }}"),
            {%- endfor %}
        }
    }
}
