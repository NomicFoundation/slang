{%- set target = model.structured_cst_model -%}

//! Attaches the `NatSpec` comments to the CST nodes they document, only walking the nodes that are
//! documentable, or can contain one.

use crate::structured_cst::natspec::NatSpec;
use crate::structured_cst::nodes;
use crate::structured_cst::text_range::TextStart;

/// Attaches to each documentable node of `source_unit` the `NatSpec` comment that `natspec_at`
/// returns for the offset where the node starts.
pub fn attach_natspec(
    source_unit: &mut nodes::SourceUnit,
    natspec_at: &impl Fn(usize) -> Option<NatSpec>,
) {
    attach_source_unit(source_unit, natspec_at);
}

{% for parent_type, sequence in target.sequences %}
  {%- if target.has_documentable_descendant[parent_type] %}
    fn attach_{{ parent_type | snake_case }}<F: Fn(usize) -> Option<NatSpec>>(
      node: &mut nodes::{{ parent_type }},
      natspec_at: &F,
    ) {
      {%- if sequence.is_documentable %}
        if let Some(start) = node.calculate_text_start() {
          node.natspec = natspec_at(start);
        }
      {%- endif %}
      {%- for field in sequence.fields %}
        {%- if not field.field_type.is_terminal and target.has_documentable_descendant[field.field_type.name] %}
          {%- if field.is_optional %}
            if let Some(child) = &mut node.{{ field.label | snake_case }} {
              attach_{{ field.field_type.name | snake_case }}(child, natspec_at);
            }
          {%- else %}
            attach_{{ field.field_type.name | snake_case }}(&mut node.{{ field.label | snake_case }}, natspec_at);
          {%- endif %}
        {%- endif %}
      {%- endfor %}
    }
  {%- endif %}
{% endfor %}

{% for parent_type, choice in target.choices %}
  {%- if target.has_documentable_descendant[parent_type] %}
    fn attach_{{ parent_type | snake_case }}<F: Fn(usize) -> Option<NatSpec>>(
      node: &mut nodes::{{ parent_type }},
      natspec_at: &F,
    ) {
      // Only the variants that can contain a documentable node are walked: the `_` arm may be
      // unreachable, or the only other arm
      #[allow(
        unreachable_patterns,
        clippy::match_wildcard_for_single_variants,
        clippy::single_match
      )]
      match node {
        {%- for variant in choice.variants %}
          {%- if not variant.variant_type.is_terminal and target.has_documentable_descendant[variant.variant_type.name] %}
            nodes::{{ parent_type }}::{{ variant.variant_type.name }}(child) => {
              attach_{{ variant.variant_type.name | snake_case }}(child, natspec_at);
            }
          {%- endif %}
        {%- endfor %}
        _ => {}
      }
    }
  {%- endif %}
{% endfor %}

{% for parent_type, collection in target.collections %}
  {%- if target.has_documentable_descendant[parent_type] %}
    fn attach_{{ parent_type | snake_case }}<F: Fn(usize) -> Option<NatSpec>>(
      node: &mut nodes::{{ parent_type }},
      natspec_at: &F,
    ) {
      for element in &mut node.elements {
        attach_{{ collection.item_type.name | snake_case }}(element, natspec_at);
      }
    }
  {%- endif %}
{% endfor %}
