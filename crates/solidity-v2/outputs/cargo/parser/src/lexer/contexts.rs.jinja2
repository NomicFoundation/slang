{#- Renders the `LexemeKind` of a keyword match, choosing between its reserved and unreserved kinds by language version if needed. -#}
{%- component v2.lexer.keyword_kind(keyword) -%}
    {%- if keyword.reserved.type == "Always" -%}
        LexemeKind::{{ keyword.kind }}_Reserved
    {%- elif keyword.reserved.type == "Never" -%}
        LexemeKind::{{ keyword.kind }}_Unreserved
    {%- else -%}
        if {{<v2.versions.specifier s={keyword.reserved} />}}.contains(lexer.extras.language_version) {
            LexemeKind::{{ keyword.kind }}_Reserved
        }
        else {
            LexemeKind::{{ keyword.kind }}_Unreserved
        }
    {%- endif -%}
{%- endcomponent v2.lexer.keyword_kind -%}

use logos::{FilterResult, Lexer, Logos};
use slang_solidity_v2_common::versions::LanguageVersion;

use crate::lexer::lexemes::{Lexeme, LexemeKind};

#[derive(Clone)]
pub struct ContextExtras {
    // Since we restricted Slang v2 lexer to only support Solidity 0.8.0+, all the remaining keywords
    // are either `Always` or `Never` versioned in the remaining versions, so we don't need this
    // information today. However, that might always change with new version releases.
    // So, let's keep it for now, even if we don't generate code that uses it yet.
    #[allow(dead_code)]
    pub language_version: LanguageVersion,
}

#[derive(Clone)]
pub enum ContextWrapper<'source> {
    {%- for context in model.parser.lexer.contexts %}
        {{ context.name }}(Lexer<'source, {{ context.name }}Context>),
    {%- endfor -%}
}

impl<'source> ContextWrapper<'source> {
    pub fn new(source: &'source str, extras: ContextExtras) -> Self {
        Self::Solidity(SolidityContext::lexer_with_extras(source, extras))
    }

    {% for new_context in model.parser.lexer.contexts %}
    #[must_use]
    pub fn morph_to_{{ new_context.name | lower }}(self) -> Self {
        match self {
            {%- for old_context in model.parser.lexer.contexts %}
                Self::{{ old_context.name }}(lexer) => {
                    {%- if old_context.name == new_context.name -%}
                        Self::{{ new_context.name }}(lexer)
                    {%- else -%}
                        Self::{{ new_context.name }}(lexer.morph())
                    {%- endif -%}
                },
            {%- endfor -%}
        }
    }
    {%- endfor %}

    pub fn next_lexeme(&mut self) -> Option<Lexeme> {
        let (kind, range) = match self {
            {%- for context in model.parser.lexer.contexts %}
                Self::{{ context.name }}(lexer) => match lexer.next() {
                    Some(Ok({{ context.name }}Context::Lexeme(kind))) => (kind, lexer.span()),
                    Some(Err(())) => (LexemeKind::UNRECOGNIZED, lexer.span()),
                    None => return None,
                },
            {%- endfor -%}
        };

        Some(Lexeme { kind, range } )
    }
}

{% for context in model.parser.lexer.contexts %}
    {%- for lexeme in context.lexemes %}
        {%- if lexeme.type == "Token" %}
            {%- for definition in lexeme.definitions %}
                {%- if definition.reject_suffix %}
                    {#
                        TODO: Most reject_suffix patterns are the same, in the future it may
                        be worth it to deduplicate them and generate unique instances.
                    #}
                    {#
                        This is its own `Logos` enum so that the pattern is compiled into a DFA at
                        build time. Building an equivalent `regex::Regex` on first use instead costs
                        a few hundred thousand instructions per thread, which dominates the cost of
                        the guard itself.
                    #}
                    /// Rejects a `{{ lexeme.kind }}` match that ends with this suffix.
                    #[derive(Logos)]
                    enum RejectSuffix{{ lexeme.kind }}{{ loop.index }} {
                        #[regex(r#"{{ definition.reject_suffix }}"#)]
                        Matched,
                    }
                {%- endif %}
            {%- endfor %}
        {%- elif lexeme.type == "Keyword" and lexeme.reject_suffix %}
            /// Rejects a `{{ lexeme.kind }}` match that ends with this suffix.
            #[derive(Logos)]
            enum RejectSuffix{{ lexeme.kind }} {
                #[regex(r#"{{ lexeme.reject_suffix }}"#)]
                Matched,
            }
        {%- endif %}
    {%- endfor %}

    #[derive(Clone, Debug, Logos)]
    #[logos(extras = ContextExtras)]
    {%- for name, regex in context.subpatterns %}
        #[logos(subpattern {{ name }} = r#"{{ regex }}"#)]
    {%- endfor -%}
    pub enum {{ context.name }}Context {
        {% for lexeme in context.lexemes -%}
            {%- set lexeme_index = loop.index -%}
            {%- if lexeme.type == "Trivia" -%}
                {# use 'allow_greedy' on trivia: https://github.com/maciejhirsz/logos/issues/520 #}
                #[regex(r#"{{ lexeme.regex }}"#, |_| { LexemeKind::{{ lexeme.kind }} }, priority = {{ 1000000 + lexeme_index }}, allow_greedy = true)]
            {%- elif lexeme.type == "Token" -%}
                {%- for definition in lexeme.definitions -%}
                    {%- if definition.reject_suffix -%}
                        #[regex(r#"{{ definition.regex }}"#, |lexer| { reject_suffix::<RejectSuffix{{ lexeme.kind }}{{ loop.index }}, _>(lexer, LexemeKind::{{ lexeme.kind }}) }, priority = {{ 2000000 + lexeme_index }})]
                    {%- else -%}
                        #[regex(r#"{{ definition.regex }}"#, |_| { LexemeKind::{{ lexeme.kind }} }, priority = {{ 2000000 + lexeme_index }})]
                    {%- endif -%}
                {%- endfor -%}
            {%- elif lexeme.type == "Keyword" and lexeme.reject_suffix -%}
                #[regex(r#"{{ lexeme.regex }}"#, |lexer| { let kind = {{<v2.lexer.keyword_kind keyword={lexeme} />}}; reject_suffix::<RejectSuffix{{ lexeme.kind }}, _>(lexer, kind) }, priority = {{ 3000000 + lexeme_index }})]
            {%- elif lexeme.type == "Keyword" -%}
                {#- Only the version check needs the lexer: -#}
                {%- if lexeme.reserved.type == "Always" or lexeme.reserved.type == "Never" -%}
                    #[regex(r#"{{ lexeme.regex }}"#, |_| { {{<v2.lexer.keyword_kind keyword={lexeme} />}} }, priority = {{ 3000000 + lexeme_index }})]
                {%- else -%}
                    #[regex(r#"{{ lexeme.regex }}"#, |lexer| {
                        {{<v2.lexer.keyword_kind keyword={lexeme} />}}
                    }, priority = {{ 3000000 + lexeme_index }})]
                {%- endif -%}
            {%- else -%}
                {{ throw(message = "Unrecognized lexeme type: " ~ lexeme.type) }}
            {%- endif -%}
        {%- endfor %}
        Lexeme(LexemeKind),
    }
{% endfor %}

/// Rejects the current match if it ends with a `Suffix` match, or emits it as `kind` otherwise.
///
/// Kept out of line on purpose: this only runs after a token match, and inlining the
/// lookahead DFA into the context lexer pushes the whole lexer past the threshold for
/// being inlined into the LALRPOP driver.
#[inline(never)]
fn reject_suffix<'source, Suffix, Context>(
    lexer: &mut Lexer<'source, Context>,
    kind: LexemeKind,
) -> FilterResult<LexemeKind, ()>
where
    Suffix: Logos<'source, Source = str>,
    Suffix::Extras: Default,
    Context: Logos<'source, Source = str>,
{
    // `logos` only ever attempts a match at the lexer's current position, so an
    // `Ok` from the very first `next()` is a match anchored at the start of the
    // remainder, and its span length is the length of that match.
    let mut lookahead = Suffix::lexer(lexer.remainder());

    if matches!(lookahead.next(), Some(Ok(_))) {
        lexer.bump(lookahead.span().end);
        FilterResult::Error(())
    } else {
        FilterResult::Emit(kind)
    }
}
