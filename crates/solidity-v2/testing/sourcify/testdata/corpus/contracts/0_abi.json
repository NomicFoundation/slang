  "target_contract": "Abi",
  "sources": {
    "Abi.sol": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.22;\n\nlibrary Codec {\n    event Decoded(int8 indexed code);\n    error Undecodable(int8 code);\n}\n\nabstract contract Base {\n    event Moved(uint256 amount);\n    error Boom(uint256 code);\n\n    function zap() external virtual {}\n}\n\ncontract Abi is Base {\n    struct Order {\n        address maker;\n        uint96 price;\n        bytes32[] tags;\n    }\n\n    enum Side { Buy, Sell }\n\n    event Moved(address indexed from, address indexed to, uint256 amount);\n    error Rejected(Order order, Side side);\n\n    uint256 public total;\n    mapping(address => Order) public orders;\n\n    constructor(uint256 start) payable {\n        total = start;\n    }\n\n    receive() external payable {}\n\n    fallback(bytes calldata input) external returns (bytes memory) {\n        return input;\n    }\n\n    function place(Order calldata order, Side side) external returns (uint256 id, bool filled) {\n        if (order.price == 0) revert Rejected(order, side);\n        emit Moved(msg.sender, order.maker, order.price);\n        emit Codec.Decoded(1);\n        return (total, false);\n    }\n\n    function quote(uint256 amount) external pure returns (uint256) {\n        return amount;\n    }\n\n    function quote(address token, uint256 amount) external view returns (uint256) {\n        if (token == address(this)) revert Codec.Undecodable(-1);\n        return amount + total;\n    }\n\n    function zap() external override {\n        emit Base.Moved(total);\n        revert Boom(1);\n    }\n}\n"
  },
