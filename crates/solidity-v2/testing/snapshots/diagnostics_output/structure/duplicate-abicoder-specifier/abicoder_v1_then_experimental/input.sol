pragma solidity *;

// `abicoder v1` is unsupported and disabled, so it does not specify the ABI
// coder: the following `experimental ABIEncoderV2` is the first specifier, not a
// duplicate. Only `unsupported-abicoder-v1` is reported.
pragma abicoder v1;
pragma experimental ABIEncoderV2;
