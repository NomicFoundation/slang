pragma solidity *;

// `experimental ABIEncoderV2` specifies the ABI coder. The following
// `abicoder v1` is unsupported and disabled, so it is reported as
// `unsupported-abicoder-v1` rather than a duplicate specifier.
pragma experimental ABIEncoderV2;
pragma abicoder v1;
