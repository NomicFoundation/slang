pragma solidity *;

// `abicoder v1` is unsupported and disabled, so it does not count as specifying
// the ABI coder: the following `abicoder v2` is the first specifier, not a
// duplicate. Only `unsupported-abicoder-v1` is reported.
pragma abicoder v1;
pragma abicoder v2;
