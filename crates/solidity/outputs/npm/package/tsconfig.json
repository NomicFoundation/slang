{
  "extends": "../../../../../tsconfig.json",

  // The WASM glue under 'wasm/' is consumed from source rather than compiled,
  // so only its type definitions are included, to check the sources against:
  "include": ["./src/**/*", "./wasm/**/*.d.mts", "./wasm/**/*.d.ts"],

  "compilerOptions": {
    /* Emit */
    "noEmit": false,
    "outDir": "./target",

    /* Projects */
    "composite": true,
    "incremental": true,
    "rootDir": "./src",
    "tsBuildInfoFile": "target/tsc/.tsbuildinfo"
  }
}
