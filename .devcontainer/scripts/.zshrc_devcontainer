#!/bin/zsh

repo_root="/workspaces/slang"

# Hermit
eval "$("${repo_root}/bin/hermit" shell-hooks --print --zsh)"

for name in "task" "infra"; do
  # __SLANG_SHELL_COMPLETIONS_PATH__ (keep in sync)
  completions_file="${repo_root}/target/shell-completions/${name}.zsh"

  if [[ ! -f "${completions_file}" ]]; then
    echo "Make sure to reload the shell after \`task setup\` completes for \`${name}\` shell completion." >&2
  else
    # Make sure to rebuild the completion cache if these completions are not included yet,
    # otherwise completions may not work properly.
    if [[ -f "$HOME/.zcompdump" ]] && ! grep -q "_${name}" "$HOME/.zcompdump"; then
      rm "$HOME/.zcompdump" 2> /dev/null
    fi

    source "${completions_file}"
  fi
done

# ZSH Completions
autoload -Uz compinit && compinit
